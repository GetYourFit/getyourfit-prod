#!/bin/sh
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
pinned=24.11.0
required=$(sed -n 's/.*"node": *">=\([0-9][0-9.]*\)".*/\1/p' "$root/package.json" | head -n 1)
[ -n "$required" ] || { echo "require-node: no node engine floor in package.json" >&2; exit 1; }
current=$(node -v 2>/dev/null | sed 's/^v//' || true)
if [ -n "$current" ] && [ "$(printf '%s\n%s\n' "$required" "$current" | sort -V | head -n 1)" = "$required" ]; then
  exec "$@"
fi
if [ -n "${REQUIRE_NODE_PROVISIONED:-}" ]; then
  echo "require-node: Node.js >=$required is required, found ${current:-none} after provisioning node@$pinned" >&2
  exit 1
fi
echo "require-node: Node.js >=$required is required, found ${current:-none}; provisioning node@$pinned" >&2
REQUIRE_NODE_PROVISIONED=1 exec npm exec --yes --package="node@$pinned" -- "$0" "$@"
