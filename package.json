{
  "name": "getyourfit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"node server/index.mjs\" \"vite --host 127.0.0.1 --port 5173\"",
    "server": "node server/index.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "reset:local": "node scripts/reset-local-data.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
