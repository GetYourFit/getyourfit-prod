    "verify:auth": "node scripts/verify-auth.mjs",
    "feature-map": "node scripts/gyf.mjs map"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^12.4.1",
